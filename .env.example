# ============================================================
# Medflux – Umgebungsvariablen (Beispiel)
# Kopiere diese Datei nach .env und fülle die Werte aus.
# ============================================================

# --- Backend (FastAPI) ---
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Datenbank (STEP 10: PostgreSQL ist die Ziel-DB; SQLite nur optionaler Dev-Restfall)
DATABASE_URL=postgresql+psycopg://medflux:DEIN_PASSWORT@127.0.0.1:5432/medflux

# CORS: erlaubte Frontend-Origins (kommagetrennt)
CORS_ORIGINS=http://localhost:3000

# Maximale Upload-Größe in MB
MAX_UPLOAD_SIZE_MB=50

# --- Lokale KI (Ollama) ---
# KI-Anbieter (Standard: ollama – lokal, keine externen Dienste)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modellname, wie er in Ollama installiert ist (Bootstrap-Default; die aktive
# Auswahl kann in den Einstellungen geändert und serverseitig persistiert werden)
OLLAMA_MODEL=qwen3:8b
# Weitere lokale Provider (Erkennung nur über diese konfigurierten Endpunkte)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LLAMA_CPP_BASE_URL=
GENERIC_OPENAI_BASE_URL=
# Zeitlimit (Sekunden) für lokale Provider-/Modell-Erkennung
AI_DISCOVERY_TIMEOUT_SECONDS=2.0
# KI-Anfragen gelten als fehlgeschlagen nach (Sekunden)
AI_REQUEST_TIMEOUT_SECONDS=120
# Konservative Generierungseinstellungen (faktenorientiert, niedrige Variation)
AI_TEMPERATURE=0.1
# Maximale Anzahl an Ausgabe-Tokens pro Anfrage (num_predict)
AI_MAX_TOKENS=256
# Strukturierte Extraktion (Schritt 7): eigenes Ausgabe-Budget für das volle
# Vertrags-JSON (größer als AI_MAX_TOKENS). qwen3:8b-sicher; formal in Schritt 8.
AI_EXTRACTION_MAX_TOKENS=2048
HARNESS_CONTEXT_TOKENS=16384
HARNESS_OUTPUT_TOKENS=3000
HARNESS_MAX_CALLS=64
AI_REPEAT_PENALTY=1.0
# Deterministische Chunk-Größe (Zeichen) für lange Verträge
AI_MAX_CHUNK_CHARACTERS=6000
# Thinking-Modus von Qwen3-artigen Modellen (false = Modell antwortet direkt)
OLLAMA_THINK=false

# --- OCR / Textextraktion ---
# OCR für gescannte/textarme Seiten aktivieren
OCR_ENABLED=true
# Optional: expliziter Pfad zur Tesseract-Binary (leer = aus PATH suchen)
TESSERACT_CMD=
# OCR-Sprache (Tesseract-Code), für Deutsch: deu
OCR_LANG=deu

# --- Pfade ---
# Ablage importierter Vertragsdokumente
DATA_DIR=./data
CONTRACTS_DIR=./data/contracts
BACKUPS_DIR=./data/backups

# --- Sicherheit (Werte hier NICHT produktiv verwenden) ---
# Secret für Signieren lokaler Sitzungen; in Produktion rotieren
APP_SECRET_KEY=change-me
# Login deaktiviert im MVP bis Schritt 16
AUTH_ENABLED=false
