!data/database/.gitkeep
!data/backups/.gitkeep

# Nested/Backend-Testdaten – Vertrags-Storage je Backend (nie einchecken)
backend/data/
**/data/contracts/*
**/data/database/*
**/data/backups/*
!**/data/contracts/.gitkeep
!**/data/database/.gitkeep
!**/data/backups/.gitkeep

# Benchmark – echte Vertrags-PDFs, Berichte & Artefakte (nie einchecken)
data/benchmark/
data/benchmark_v2/

# PostgreSQL-Datenverzeichnisse
pgdata/
data/pgdata/
*.pgdata
postgres-data/

# Modell-Dateien / Gewichte (db.models sind Quellcode, nur Datei-Extensions meiden)
