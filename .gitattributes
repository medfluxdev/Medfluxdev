# Unified line endings (added during branch unification 2026-10-04).
# Source files are stored with LF in the repository; Windows scripts keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
