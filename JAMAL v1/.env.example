# ============================================================
# Medflux – Umgebungsvariablen (Beispiel)
# Kopiere diese Datei nach .env und fülle die Werte aus.
# ============================================================

# --- Backend (FastAPI) ---
# Erlaubt: development | test | pilot | production
# pilot/production werden beim Start abgelehnt, wenn AUTH_ENABLED=false oder
# AUTH_COOKIE_SECURE=false ist.
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Datenbank (STEP 10: PostgreSQL ist die Ziel-DB; SQLite nur optionaler Dev-Restfall)
DATABASE_URL=postgresql+psycopg://medflux:DEIN_PASSWORT@127.0.0.1:5432/medflux

# CORS: erlaubte Frontend-Origins (kommagetrennt)
CORS_ORIGINS=http://localhost:3000

# Maximale Upload-Größe in MB
MAX_UPLOAD_SIZE_MB=50

# --- Lokale KI (Ollama) ---
# KI-Anbieter (Standard: ollama – lokal, keine externen Dienste)
AI_PROVIDER=ollama
# Kein OLLAMA_MODEL-Default: das aktive Modell wird immer explizit in der UI ausgewählt.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional: Anzahl der Modell-Layer, die Ollama auf die GPU auslagern soll.
# Leer = Ollama entscheidet automatisch. Auf einer dedizierten NVIDIA-Testmaschine
# kann z. B. 999 verwendet werden, um maximalen GPU-Offload anzufordern.
OLLAMA_NUM_GPU=
# Modellname, wie er in Ollama installiert ist (Bootstrap-Default; die aktive
# Auswahl kann in den Einstellungen geändert und serverseitig persistiert werden)
# Weitere lokale Provider (Erkennung nur über diese konfigurierten Endpunkte)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LLAMA_CPP_BASE_URL=
GENERIC_OPENAI_BASE_URL=
# Zeitlimit (Sekunden) für lokale Provider-/Modell-Erkennung
AI_DISCOVERY_TIMEOUT_SECONDS=2.0
# KI-Anfragen gelten als fehlgeschlagen nach (Sekunden)
AI_REQUEST_TIMEOUT_SECONDS=300
# Konservative Generierungseinstellungen (faktenorientiert, niedrige Variation)
AI_TEMPERATURE=0.1
# Maximale Anzahl an Ausgabe-Tokens pro Anfrage (num_predict)
AI_MAX_TOKENS=256
# Provider repeat penalty. JAMAL production-safe default remains 1.3.
AI_REPEAT_PENALTY=1.3
# Harness production defaults. Ahmad's larger benchmark profile can be enabled
# deliberately (16384 / 3000 / 64) on hardware that can actually sustain it.
HARNESS_CONTEXT_TOKENS=8192
HARNESS_OUTPUT_TOKENS=1800
HARNESS_MAX_CALLS=32
# Engine selection: V3 is the production default because it can route image-only
# and mixed PDFs through bounded local vision. V2 remains available as a legacy
# text-oriented compatibility engine.
HARNESS_ENGINE=v3
HARNESS_VISION_PAGES_PER_BATCH=4
HARNESS_VISION_BATCH_SCALE=1600
HARNESS_VISION_MIN_PAGES_FOR_BATCH=2
HARNESS_VISION_MAX_CALLS=16
# Strukturierte Extraktion: eigenes Ausgabe-Budget für das volle Vertrags-JSON.
AI_EXTRACTION_MAX_TOKENS=8192
# Deterministische Chunk-Größe (Zeichen) für lange Verträge
AI_MAX_CHUNK_CHARACTERS=6000
# Thinking-Modus von Qwen3-artigen Modellen (false = Modell antwortet direkt)
OLLAMA_THINK=false

# --- OCR / Textextraktion ---
# OCR für gescannte/textarme Seiten aktivieren
OCR_ENABLED=true
# Optional: expliziter Pfad zur Tesseract-Binary (leer = aus PATH suchen)
TESSERACT_CMD=
# OCR-Sprache (Tesseract-Code), für Deutsch: deu
OCR_LANG=deu
# Optional perception/evidence helper only; failure never becomes a semantic
# authority and the default stays disabled.
DOCUMENT_INTELLIGENCE_ATOMIC_GEOMETRY=false
DOCUMENT_INTELLIGENCE_ATOMIC_GEOMETRY_DPI=200
# Docling-Beschleuniger: auto nutzt CUDA, wenn die lokale Installation sie
# bereitstellt; cpu ist nur ein expliziter Fallback.
DOCUMENT_INTELLIGENCE_DEVICE=auto

# --- Pfade ---
# Ablage importierter Vertragsdokumente
DATA_DIR=./data
CONTRACTS_DIR=./data/contracts
BACKUPS_DIR=./data/backups

# --- Lokale Anmeldung / Sicherheit (STEP 16) ---
# development/test dürfen bewusst ohne Anmeldung betrieben werden.
# pilot/production starten NUR mit AUTH_ENABLED=true, eigenem APP_SECRET_KEY und
# AUTH_COOKIE_SECURE=true. Dadurch kann eine Pilot-/Produktionsinstanz nicht
# versehentlich im unauthentifizierten Entwicklungsmodus hochfahren.
# Beispiel zur Erzeugung eines Secrets (PowerShell/Python):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me
AUTH_ENABLED=false
AUTH_COOKIE_NAME=medflux_session
AUTH_SESSION_TTL_SECONDS=28800
# Revocable Account sessions used by Ahmad's user/membership UI.
AUTH_SESSION_DAYS=14
# Allows shorter local development credentials only; disable outside development.
DEVELOPMENT_AUTH_MODE=true
# Lokaler Admin wird beim Setup als admin@medflux.local sichergestellt.
# Das Passwort wird NICHT im Repository gespeichert. Bei einer frischen DB kann
# es einmalig interaktiv eingegeben oder nur für den Setup-Prozess gesetzt werden:
# MEDFLUX_LOCAL_ADMIN_PASSWORD=<lokales Passwort>
# Lokal über HTTP false; in pilot/production zwingend true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax


# JAMAL v1 scanned-contract pipeline
# true = keep OCR/native text and add bounded local vision only for pages that
# need visual/layout recovery. No cloud OCR/AI is used.
HYBRID_SCANNED_CONTRACTS_ENABLED=true
